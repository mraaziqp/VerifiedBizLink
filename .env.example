# App URL — production domain
NEXT_PUBLIC_APP_URL="https://www.verifiedbizlink.co.za"

# Resend — transactional email (https://resend.com)
# Create a free account, add verifiedbizlink.co.za as a sending domain, then copy the API key
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@verifiedbizlink.co.za"

# Setup secret — used to protect /api/setup and /api/setup/migrate
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SETUP_SECRET=""

# Stripe Integration (https://stripe.com)
