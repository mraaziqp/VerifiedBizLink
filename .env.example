# Neon PostgreSQL (get connection string from neon.tech console)
DATABASE_URL=""

# JWT Secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Encrypts 2FA (TOTP) secrets at rest — a 64-char hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TWO_FACTOR_ENCRYPTION_KEY=""

# App URL — production domain
NEXT_PUBLIC_APP_URL="https://www.verifiedbizlink.co.za"

# Resend — transactional email (https://resend.com)
# Create a free account, add verifiedbizlink.co.za as a sending domain, then copy the API key
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@verifiedbizlink.co.za"

# Setup secret — used to protect /api/setup and /api/setup/migrate
# Generate with: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
SETUP_SECRET=""

# PayFast — the live payment gateway (https://www.payfast.co.za)
# Get merchant ID/key from your PayFast dashboard. For local dev, point
# PAYFAST_URL at the sandbox instead: https://sandbox.payfast.co.za/eng/process
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_URL="https://www.payfast.co.za/eng/process"
# Optional but recommended by PayFast — set the same passphrase in your
# PayFast dashboard's security settings.
PAYFAST_PASSPHRASE=""

# Stripe / PayPal — not currently wired to any live checkout flow (PayFast
# is the active gateway). Kept here only if you plan to add them later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_PAYPAL_CLIENT_ID=""
PAYPAL_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
PAYPAL_WEBHOOK_ID=""
