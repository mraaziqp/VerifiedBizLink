{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "DATABASE_URL": {
      "description": "Neon PostgreSQL connection string",
      "required": true
    },
    "JWT_SECRET": {
      "description": "JWT signing secret (min 32 chars)",
      "required": true
    },
    "NEXT_PUBLIC_APP_URL": {
      "description": "Production app URL",
      "required": true
    },
    "GOOGLE_API_KEY": {
      "description": "Google Gemini API key for AI chat",
      "required": false
    },
    "RESEND_API_KEY": {
      "description": "Resend email API key",
      "required": true
    },
    "STRIPE_SECRET_KEY": {
      "description": "Stripe secret key",
      "required": false
    },
    "SETUP_SECRET": {
      "description": "Setup route protection secret",
      "required": true
    }
  },
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**": {
      "memory": 1024,
      "maxDuration": 60
    }
  }
}
