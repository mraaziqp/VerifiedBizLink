{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/**": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/abandoned-signups",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "0 2 * * *"
    }
  ]
}
